# Generated by `pnpm db:setup` into .env.local (never committed). Names only here.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
DATABASE_OWNER_URL=postgres://octobrief_owner:<password>@127.0.0.1:5450/octobrief
DATABASE_URL=postgres://octobrief_app:<password>@127.0.0.1:5450/octobrief
DATABASE_WORKER_URL=postgres://octobrief_worker:<password>@127.0.0.1:5450/octobrief
WEB_PORT=3310
PUBLIC_URL=http://127.0.0.1:3310
OIDC_ISSUER=http://127.0.0.1:4320
OIDC_ALLOW_INSECURE_ISSUER=true
OIDC_CLIENT_ID=octobrief-dev
OIDC_CLIENT_SECRET=
ADMIN_EMAILS=alba.amministratrice@example.test
BLOB_DIR=/absolute/path/to/octobrief-new/.data/blobs
RETENTION_DAYS=365
# 32 random bytes in base64 (`openssl rand -base64 32`): seals the credentials of the sources.
SECRETS_KEY=
SYNC_INTERVAL_MINUTES=15
# The only place synchronized folders may be read from (absolute path); not set: none is read.
# SYNC_FOLDERS_ROOT=/absolute/path/to/OctobriefSync
# The recipes and the templates of the installation (absolute paths), and the isolated renderer
# of Word/PowerPoint/Excel files (optional: without it only Markdown is made).
RECIPES_DIR=/absolute/path/to/octobrief-new/recipes
TEMPLATES_DIR=/absolute/path/to/octobrief-new/templates
# Start it with: docker compose --env-file .env.local --profile renderer up -d --wait
RENDERER_URL=http://127.0.0.1:5451
# Model and encoder: fake by default (no network). See demo/03-conoscenza/COPIONE.md.
LLM_BACKEND=fake
EMBEDDING_BACKEND=fake
