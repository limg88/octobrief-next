{
  "changeSummary": "Gli aperti oltre soglia si scelgono per età, cioè dalla data di creazione nel tracker, che ora il connettore ADO legge come quello Jira; «Aperto dal» viene dalla data di creazione. Gli aperti di cui il tracker non dà la data di creazione sono in un elenco a parte, scelti come prima dall'ultimo aggiornamento, e il testo lo dice al PM. Controlli invariati, più uno: anche l'elenco a parte sta fra gli aperti.",
  "recipe": {
    "schema": "octobrief.recipe/1",
    "slug": "dashboard-bug-cr",
    "version": "1.1.0",
    "title": "Dashboard bug e CR",
    "purpose": "Mostra bug e richieste di modifica (CR) del tracker: aperti e chiusi per tipo, per priorità e per stato, i chiusi del periodo e l'elenco degli aperti, con quelli aperti da prima della soglia. Ogni conteggio viene dal tracker; la gravità non c'è nel tracker e non si deduce.",
    "audience": "both",
    "clientVersionWhen": {
      "parameter": "for_client",
      "equals": "yes"
    },
    "lang": "it",
    "parameters": [
      {
        "id": "period",
        "type": "period",
        "label": "Periodo della dashboard",
        "required": true,
        "step": 1
      },
      {
        "id": "bug_type",
        "type": "text",
        "label": "Tipo dei bug nel tracker",
        "help": "Come lo scrive il tracker, per esempio «Bug».",
        "required": true,
        "step": 1,
        "maxLength": 60
      },
      {
        "id": "cr_type",
        "type": "text",
        "label": "Tipo delle richieste di modifica (CR) nel tracker",
        "help": "Come lo scrive il tracker, per esempio «Change Request».",
        "required": true,
        "step": 1,
        "maxLength": 60
      },
      {
        "id": "open_states",
        "type": "rows",
        "label": "Stati aperti nel tracker",
        "help": "Gli stati che nel tracker vogliono dire ancora aperto, uno per riga, come li scrive il tracker.",
        "required": true,
        "step": 1,
        "maxRows": 10,
        "key": ["state"],
        "columns": [
          {
            "id": "state",
            "label": "Stato",
            "kind": "text",
            "maxLength": 60
          }
        ]
      },
      {
        "id": "closed_states",
        "type": "rows",
        "label": "Stati di chiusura nel tracker",
        "help": "Gli stati che nel tracker vogliono dire chiuso, uno per riga, come li scrive il tracker.",
        "required": true,
        "step": 1,
        "maxRows": 10,
        "key": ["state"],
        "columns": [
          {
            "id": "state",
            "label": "Stato",
            "kind": "text",
            "maxLength": 60
          }
        ]
      },
      {
        "id": "stale_before",
        "type": "date",
        "label": "Soglia: aperti creati entro il",
        "help": "Gli aperti creati nel tracker in questo giorno o prima vanno nell'elenco di quelli oltre soglia. Degli aperti senza data di creazione conta l'ultimo aggiornamento, in questo giorno o prima, e sono elencati a parte. Se la salti, i due elenchi restano «non dedotto».",
        "required": false,
        "step": 2
      },
      {
        "id": "for_client",
        "type": "choice",
        "label": "Serve anche la versione per il cliente?",
        "help": "Se la salti, la dashboard resta solo interna.",
        "required": false,
        "step": 2,
        "options": [
          {
            "value": "yes",
            "label": "Sì, anche per il cliente"
          },
          {
            "value": "no",
            "label": "No, solo interna"
          }
        ]
      }
    ],
    "prerequisites": [
      {
        "kind": "source",
        "sourceKinds": ["ado", "jira"],
        "level": "required"
      }
    ],
    "sections": [
      {
        "id": "summary",
        "title": "Riepilogo di bug e CR ({{period}})",
        "required": true,
        "version": "both",
        "removable": false,
        "blocks": [
          {
            "kind": "data_table",
            "id": "perimeter_by_type",
            "title": "Bug e CR per tipo",
            "query": {
              "kind": "tracker",
              "filter": {
                "types": [
                  {
                    "parameter": "bug_type"
                  },
                  {
                    "parameter": "cr_type"
                  }
                ]
              },
              "groupBy": "type"
            },
            "key": ["type"],
            "columns": [
              {
                "id": "type",
                "title": "Tipo",
                "from": {
                  "kind": "field",
                  "field": "key"
                },
                "category": "other"
              },
              {
                "id": "items",
                "title": "Elementi",
                "from": {
                  "kind": "field",
                  "field": "count"
                },
                "category": "other"
              }
            ]
          },
          {
            "kind": "data_table",
            "id": "open_by_type",
            "title": "Aperti per tipo",
            "query": {
              "kind": "tracker",
              "filter": {
                "types": [
                  {
                    "parameter": "bug_type"
                  },
                  {
                    "parameter": "cr_type"
                  }
                ],
                "states": [
                  {
                    "parameter": "open_states"
                  }
                ]
              },
              "groupBy": "type"
            },
            "key": ["type"],
            "columns": [
              {
                "id": "type",
                "title": "Tipo",
                "from": {
                  "kind": "field",
                  "field": "key"
                },
                "category": "other"
              },
              {
                "id": "open",
                "title": "Aperti",
                "from": {
                  "kind": "field",
                  "field": "count"
                },
                "category": "other"
              }
            ]
          },
          {
            "kind": "data_table",
            "id": "closed_by_type",
            "title": "Chiusi per tipo",
            "query": {
              "kind": "tracker",
              "filter": {
                "types": [
                  {
                    "parameter": "bug_type"
                  },
                  {
                    "parameter": "cr_type"
                  }
                ],
                "states": [
                  {
                    "parameter": "closed_states"
                  }
                ]
              },
              "groupBy": "type"
            },
            "key": ["type"],
            "columns": [
              {
                "id": "type",
                "title": "Tipo",
                "from": {
                  "kind": "field",
                  "field": "key"
                },
                "category": "other"
              },
              {
                "id": "closed",
                "title": "Chiusi",
                "from": {
                  "kind": "field",
                  "field": "count"
                },
                "category": "other"
              }
            ]
          },
          {
            "kind": "data_value",
            "id": "perimeter_total",
            "label": "Bug e CR nel tracker",
            "compute": {
              "op": "count",
              "block": "perimeter_items"
            },
            "category": "other"
          },
          {
            "kind": "data_value",
            "id": "open_total",
            "label": "Aperti",
            "compute": {
              "op": "count",
              "block": "open_items"
            },
            "category": "other"
          },
          {
            "kind": "data_value",
            "id": "closed_total",
            "label": "Chiusi",
            "compute": {
              "op": "count",
              "block": "closed_items"
            },
            "category": "other"
          },
          {
            "kind": "text_slot",
            "id": "summary_text",
            "instructions": "Riassumi lo stato di bug e CR: aperti, chiusi, priorità degli aperti, aperti da prima della soglia (per età) e, a parte, aperti senza data di creazione fermi oltre la soglia. Ogni numero è un valore delle tabelle, con la sua fonte. Non parlare di gravità: il tracker non la dà.",
            "natures": ["fact", "inference"],
            "maxChars": 1000
          }
        ]
      },
      {
