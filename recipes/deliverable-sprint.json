{
  "changeSummary": "Gli story point sono solo interni: la colonna Story point esce dalla tabella per feature della versione per il cliente e resta nella versione interna, nella sezione «Perimetro e attribuzioni». Conta per tipo e raggruppa sotto la feature. Nuovo parametro facoltativo «Tipi di elemento da contare» (come li scrive il tracker): se il PM lo salta si contano tutti i tipi; i Task e i Sub-task non si contano mai. Nuova tabella «Elementi per tipo» nella panoramica. L'avanzamento per feature risale la catena dei padri fino alla feature (un Task sotto un PBI conta sotto la feature del PBI), non si ferma al padre diretto.",
  "recipe": {
    "schema": "octobrief.recipe/1",
    "slug": "deliverable-sprint",
    "version": "1.2.0",
    "title": "Deliverable Sprint",
    "purpose": "Presenta al cliente l'avanzamento di uno sprint: panoramica, avanzamento per feature, bug e CR, prossimi passi; ogni conteggio viene dal tracker.",
    "audience": "client",
    "lang": "it",
    "parameters": [
      {
        "id": "period",
        "type": "period",
        "label": "Periodo dello sprint",
        "required": true,
        "step": 1
      },
      {
        "id": "sprint",
        "type": "text",
        "label": "Sprint",
        "help": "Il nome dello sprint come lo scrive il tracker.",
        "required": true,
        "step": 1,
        "maxLength": 100
      },
      {
        "id": "closed_states",
        "type": "rows",
        "label": "Stati di chiusura nel tracker",
        "help": "Gli stati che nel tracker vogliono dire chiuso, uno per riga, come li scrive il tracker.",
        "required": true,
        "step": 1,
        "maxRows": 10,
        "key": ["state"],
        "columns": [
          {
            "id": "state",
            "label": "Stato",
            "kind": "text",
            "maxLength": 60
          }
        ]
      },
      {
        "id": "counted_types",
        "type": "rows",
        "label": "Tipi di elemento da contare",
        "help": "I tipi da contare, uno per riga, come li scrive il tracker (per esempio Product Backlog Item, Bug). I Task e i Sub-task non si contano mai. Se lo salti si contano tutti gli altri tipi.",
        "required": false,
        "step": 1,
        "maxRows": 10,
        "key": ["type"],
        "columns": [
          {
            "id": "type",
            "label": "Tipo",
            "kind": "text",
            "maxLength": 60
          }
        ]
      },
      {
        "id": "bug_type",
        "type": "text",
        "label": "Tipo dei bug nel tracker",
        "required": true,
        "step": 2,
        "maxLength": 60
      },
      {
        "id": "cr_type",
        "type": "text",
        "label": "Tipo delle richieste di modifica (CR) nel tracker",
        "required": true,
        "step": 2,
        "maxLength": 60
      },
      {
        "id": "excluded_items",
        "type": "work_item_selection",
        "label": "Elementi da escludere dal perimetro",
        "required": false,
        "step": 2,
        "multiple": true
      },
      {
        "id": "attributions",
        "type": "rows",
        "label": "Attribuzioni decise da te",
        "help": "Per un elemento senza feature nel tracker, la riga (feature) a cui lo attribuisci.",
        "required": false,
        "step": 2,
        "maxRows": 200,
        "columns": [
          {
            "id": "item",
            "label": "Elemento",
            "kind": "text",
            "maxLength": 40
          },
          {
            "id": "feature",
            "label": "Feature",
            "kind": "text",
            "maxLength": 100
          }
        ],
        "key": ["item"]
      }
