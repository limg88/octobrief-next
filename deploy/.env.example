# Names only. `deploy/init-env.sh` writes deploy/.env (never committed) with fresh secrets.

# The name people type in the browser (no scheme, no port) and the published HTTPS port.
SITE_HOST=octobrief.example.internal
HTTPS_PORT=443
HTTPS_BIND=0.0.0.0
PUBLIC_URL=https://octobrief.example.internal
# `internal` = Caddy's own authority; or the files in deploy/certs:
# CADDY_TLS=/certs/octobrief.crt /certs/octobrief.key
CADDY_TLS=internal

# Entra ID: https://login.microsoftonline.com/<tenant>/v2.0 — redirect URI: <PUBLIC_URL>/api/auth/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ADMIN_EMAILS=

# Generated: database passwords and the key that seals the credentials of the sources.
# Keep a copy of SECRETS_KEY with the backups: without it the stored credentials cannot be read.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
SECRETS_KEY=

RETENTION_DAYS=365
SYNC_INTERVAL_MINUTES=15

# Model and encoder. `fake` sends nothing out of the server.
LLM_BACKEND=fake
# LLM_API_URL=
# LLM_API_TOKEN=
# LLM_MODEL=
EMBEDDING_BACKEND=fake
# EMBEDDING_BACKEND=ollama
# OLLAMA_URL=http://<host>:11434
# EMBEDDING_MODEL=bge-m3
